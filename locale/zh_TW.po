# Traditional Chinese translations for English source strings.
msgid ""
msgstr ""
"Project-Id-Version: Eddington 1919\n"
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Compare readings"
msgstr "比對兩次讀數"

msgid "Measure again"
msgstr "再量一次"

msgid "Use first reading: %.2f divisions"
msgstr "選用第一次：%.2f 格"

msgid "Use second reading: %.2f divisions"
msgstr "選用第二次：%.2f 格"


msgid "［%s］換底片匣"
msgstr "［%s］換底片匣"

# London joint meeting
msgid "聯席會議"
msgstr "聯席會議"

msgid "這是你記在本子上的天空。我一直把那頁摺著。"
msgstr "這是你記在本子上的天空。我一直把那頁摺著。"

msgid "這是你出發前我寫的。旁邊還有空位。"
msgstr "這是你出發前我寫的。旁邊還有空位。"

msgid "Ashby 先生的預測・0.87″"
msgstr "Ashby 先生的預測・0.87″"

msgid "你在 1917 年的預測・%s"
msgstr "你在 1917 年的預測・%s"

msgid "你在十月寫下的理由・%s"
msgstr "你在十月寫下的理由・%s"

msgid "那頁我寫的是 0.87″。你的底片讓我有理由劃掉它。別劃到看不清。"
msgstr "那頁我寫的是 0.87″。你的底片讓我有理由劃掉它。別劃到看不清。"

msgid "你的底片還容得下零。要叫人相信這個，我會先檢查儀器。"
msgstr "你的底片還容得下零。要叫人相信這個，我會先檢查儀器。"

msgid "你的底片量出來跟我的數字接近。Sobral 的小望遠鏡給了我懷疑它的理由。"
msgstr "你的底片量出來跟我的數字接近。索布拉爾的小望遠鏡給了我懷疑它的理由。"

msgid "你的底片還容得下兩個數字。我想看看大西洋另一頭量到了什麼。"
msgstr "你的底片還容得下兩個數字。我想看看大西洋另一頭量到了什麼。"

msgid "你把數字留白了。我想聽聽其他底片能支持什麼。"
msgstr "你把數字留白了。我想聽聽其他底片能支持什麼。"

msgid "要進去了嗎？把本子帶上。"
msgstr "要進去了嗎？把本子帶上。"

msgid "進入會場"
msgstr "進入會場"

msgid "續讀"
msgstr "續讀"

msgid "你的底片・模擬"
msgstr "你的底片・模擬"

msgid "%.2f″ ± %.2f″・模擬測量"
msgstr "%.2f″ ± %.2f″・模擬測量"

msgid "你的底片量不出偏折值。"
msgstr "你的底片量不出偏折值。"

msgid "倫敦 Burlington House・1919 年 11 月 6 日"
msgstr "倫敦 Burlington House・1919 年 11 月 6 日"

msgid "皇家學會與皇家天文學會・聯席會議"
msgstr "皇家學會與皇家天文學會・聯席會議"

msgid "J. J. Thomson 爵士主持會議。"
msgstr "J. J. Thomson 爵士主持會議。"

msgid "歷史紀錄・會議紀要"
msgstr "歷史紀錄・會議紀要"

msgid "皇家天文學家 Frank Dyson 報告 Sobral 的結果。4 吋望遠鏡量得日緣偏折 1.98″。"
msgstr "皇家天文學家 法蘭克・戴森 報告 索布拉爾的結果。4 吋望遠鏡量得日緣偏折 1.98″。"

msgid "Arthur Eddington 報告 Príncipe 兩張底片量得的 1.6″ ± 0.3″（機率誤差）。"
msgstr "亞瑟・愛丁頓 報告 普林西比兩張底片量得的 1.6″ ± 0.3″（機率誤差）。"

msgid "重建圖表・歷史觀測"
msgstr "重建圖表・歷史觀測"

msgid "日緣偏折（角秒）"
msgstr "日緣偏折（角秒）"

msgid "0″・無偏折"
msgstr "0″・無偏折"

msgid "0.87″・牛頓式比較值"
msgstr "0.87″・牛頓式比較值"

msgid "1.75″・愛因斯坦的預測"
msgstr "1.75″・愛因斯坦的預測"

msgid "誤差棒表示原報告所列的正負一個機率誤差。"
msgstr "誤差棒表示原報告所列的正負一個機率誤差。"

msgid "Sobral 4 吋・1.98″ ± 0.12″（機率誤差）"
msgstr "索布拉爾4 吋・1.98″ ± 0.12″（機率誤差）"

msgid "Príncipe・1.61″ ± 0.30″（機率誤差）"
msgstr "普林西比・1.61″ ± 0.30″（機率誤差）"

msgid "Sobral 天體照相儀・同一批底片，兩種尺度處理"
msgstr "索布拉爾 天體照相儀・同一批底片，兩種尺度處理"

msgid "約 0.93″・採用推得的尺度變化"
msgstr "約 0.93″・採用推得的尺度變化"

msgid "約 1.52″・採用另一種尺度處理"
msgstr "約 1.52″・採用另一種尺度處理"

msgid "Sobral 的筆記記載，檢視日食底片時發現焦點明顯改變。星像模糊。"
msgstr "索布拉爾的筆記記載，檢視日食底片時發現焦點明顯改變。星像模糊。"

msgid "底片尺度改變會改變星像之間的距離。資料歸算時須把這項變化與偏折分開。"
msgstr "底片尺度改變會改變星像之間的距離。資料歸算時須把這項變化與偏折分開。"

msgid "1.52″ 的歸算只計入折射與光行差造成的尺度變化。"
msgstr "1.52″ 的歸算只計入折射與光行差造成的尺度變化。"

msgid "這兩個數值沒有可用的機率誤差。"
msgstr "這兩個數值沒有可用的機率誤差。"

msgid "完整報告給天體照相儀底片低得多的權重，並公布其歸算結果。"
msgstr "完整報告給天體照相儀底片低得多的權重，並公布其歸算結果。"

msgid "註記精度"
msgstr "註記精度"

msgid "位移很小。你會從哪裡開始，說明底片能分辨什麼？"
msgstr "位移很小。你會從哪裡開始，說明底片能分辨什麼？"

msgid "精度與尺度"
msgstr "精度與尺度"

msgid "Sobral 4 吋望遠鏡"
msgstr "索布拉爾4 吋望遠鏡"

msgid "4 吋望遠鏡的機率誤差較小。量得的 1.98″ 支持較大的偏折。"
msgstr "4 吋望遠鏡的機率誤差較小。量得的 1.98″ 支持較大的偏折。"

msgid "Príncipe 是另一處的獨立觀測，精度較低。量得的 1.61″ 也支持較大的偏折。"
msgstr "普林西比是另一處的獨立觀測，精度較低。量得的 1.61″ 也支持較大的偏折。"

msgid "Sobral 天體照相儀的結果隨尺度處理由約 0.93″ 變為約 1.52″。兩個數字都留著。"
msgstr "索布拉爾 天體照相儀的結果隨尺度處理由約 0.93″ 變為約 1.52″。兩個數字都留著。"

msgid "Príncipe"
msgstr "普林西比"

msgid "Príncipe 讓另一個觀測地點也能查驗結果。把較大的機率誤差寫在結果旁。"
msgstr "普林西比讓另一個觀測地點也能查驗結果。把較大的機率誤差寫在結果旁。"

msgid "Sobral 較清晰的 4 吋底片給出較精確的結果。兩地都支持較大的偏折。"
msgstr "索布拉爾 較清晰的 4 吋底片給出較精確的結果。兩地都支持較大的偏折。"

msgid "Sobral 的天體照相儀"
msgstr "索布拉爾的天體照相儀"

msgid "天體照相儀的兩個數值來自同一批模糊底片。尺度假設影響它的權重。"
msgstr "天體照相儀的兩個數值來自同一批模糊底片。尺度假設影響它的權重。"

msgid "4 吋底片的機率誤差較小。Príncipe 有較大的機率誤差，獨立支持較大的偏折。"
msgstr "4 吋底片的機率誤差較小。普林西比有較大的機率誤差，獨立支持較大的偏折。"

msgid "保留這則註記"
msgstr "保留這則註記"

msgid "兩地都支持較大的偏折。把誤差棒和尺度問題與結果一同留下。"
msgstr "兩地都支持較大的偏折。把誤差棒和尺度問題與結果一同留下。"

msgid "H. F. Newall・延伸的太陽大氣"
msgstr "H. F. Newall・延伸的太陽大氣"

msgid "“I feel that the Einstein effect holds the day”\n「我認為目前是愛因斯坦效應佔上風。」"
msgstr "“I feel that the Einstein effect holds the day”\n「我認為目前是愛因斯坦效應佔上風。」"

msgid "Newall 保留另一種解釋。他問能否用類似的觀測檢驗太陽周圍是否有延伸的大氣。"
msgstr "Newall 保留另一種解釋。他問能否用類似的觀測檢驗太陽周圍是否有延伸的大氣。"

msgid "他承認這個結果，也保留了他的問題。"
msgstr "他承認這個結果，也保留了他的問題。"

msgid "Ludwik Silberstein・太陽光譜"
msgstr "Ludwik Silberstein・太陽光譜"

msgid "Silberstein 問預測中的太陽光譜重力紅移如何了。他要求也提出這項檢驗的證據。"
msgstr "Silberstein 問預測中的太陽光譜重力紅移如何了。他要求也提出這項檢驗的證據。"

msgid "威爾遜山當時已有的測量未能偵測到預期的太陽譜線位移。"
msgstr "威爾遜山當時已有的測量未能偵測到預期的太陽譜線位移。"

msgid "另一個問題，要用另一種儀器。把它記在第一個旁邊。"
msgstr "另一個問題，要用另一種儀器。把它記在第一個旁邊。"

msgid "註記待檢驗的問題"
msgstr "註記待檢驗的問題"

msgid "日食能檢驗什麼"
msgstr "日食能檢驗什麼"

msgid "你會先標記哪個問題？"
msgstr "你會先標記哪個問題？"

msgid "星光彎了多少？"
msgstr "星光彎了多少？"

msgid "這裡做了檢驗。星的位置可以量出偏折。4 吋底片與 Príncipe 都支持較大的位移。"
msgstr "這裡做了檢驗。星的位置可以量出偏折。4 吋底片與 普林西比都支持較大的位移。"

msgid "太陽大氣能解釋嗎？"
msgstr "太陽大氣能解釋嗎？"

msgid "解釋仍可受到質疑。Newall 問延伸的太陽大氣是否能解釋這個視位置的位移。"
msgstr "解釋仍可受到質疑。Newall 問延伸的太陽大氣是否能解釋這個視位置的位移。"

msgid "太陽譜線移動了嗎？"
msgstr "太陽譜線移動了嗎？"

msgid "需要獨立檢驗。這些星的位置無法量出太陽譜線的重力紅移。"
msgstr "需要獨立檢驗。這些星的位置無法量出太陽譜線的重力紅移。"

msgid "日食結果・支持較大的偏折。太陽重力紅移・本次會議仍待檢驗。"
msgstr "日食結果・支持較大的偏折。太陽重力紅移・本次會議仍待檢驗。"

msgid "Sobral 的小望遠鏡量得更精確。再看隔著一整片海的 Príncipe，也指向同一邊。"
msgstr "索布拉爾的小望遠鏡量得更精確。再看隔著一整片海的 普林西比，也指向同一邊。"

msgid "沒有那批底片，我會留著我的數字。把光譜的問題也留在這頁上。"
msgstr "沒有那批底片，我會留著我的數字。把光譜的問題也留在這頁上。"

msgid "原來的預測還在你面前。你會在這裡說什麼？"
msgstr "原來的預測還在你面前。你會在這裡說什麼？"

msgid "說你能負責的話。就算是個問題也可以。"
msgstr "說你能負責的話。就算是個問題也可以。"

msgid "寫下你的理由或保留意見"
msgstr "寫下你的理由或保留意見"

msgid "說出來，留下它"
msgstr "說出來，留下它"

msgid "修改你的話"
msgstr "修改你的話"

msgid "你在 Burlington House 說的話"
msgstr "你在 Burlington House 說的話"

msgid "這裡。放在你帶來的數字旁邊。"
msgstr "這裡。放在你帶來的數字旁邊。"

msgid "在桑迪，有一頁是寫你看見什麼。這一頁是寫你能說什麼。"
msgstr "在桑迪，有一頁是寫你看見什麼。這一頁是寫你能說什麼。"

msgid "讀報"
msgstr "讀報"

msgid "我記得那張工作檯。能告訴我誰願意為柏林的數字作證嗎？"
msgstr "我記得那張工作檯。能告訴我誰願意為柏林的數字作證嗎？"

msgid "你可以問我底片的事。我能告訴你我做過哪幾張。"
msgstr "你可以問我底片的事。我能告訴你我做過哪幾張。"

msgid "也可以問我 0.87″。把我的名字寫上，連同我今天說的話。"
msgstr "也可以問我 0.87″。把我的名字寫上，連同我今天說的話。"

msgid "如果我的舊數字又被印出來，我要讓來問的人看見這一頁。"
msgstr "如果我的舊數字又被印出來，我要讓來問的人看見這一頁。"

msgid "從長椅看劍橋的天空：煙囪正上方晴朗。再添一張椅子最好。"
msgstr "從長椅看劍橋的天空：煙囪正上方晴朗。再添一張椅子最好。"

msgid "你那頭留著椅子。我來帶茶。"
msgstr "你那頭留著椅子。我來帶茶。"

msgid "明天工作做完，再多陪我一會兒。"
msgstr "明天工作做完，再多陪我一會兒。"

msgid "你在十月對天體照相儀的判斷・%s"
msgstr "你在十月對天體照相儀的判斷・%s"

msgid "你在十月的預測・%s"
msgstr "你在十月的預測・%s"

msgid "我的底片讓我懷疑 0.87″，而 Sobral 較清晰的底片是我敢在這裡說出來的理由。"
msgstr "我的底片讓我懷疑 0.87″，而 索布拉爾 較清晰的底片是我敢在這裡說出來的理由。"

msgid "我會保留對彎曲幅度的判斷。我還想看看太陽譜線的檢驗。"
msgstr "我會保留對彎曲幅度的判斷。我還想看看太陽譜線的檢驗。"

msgid "Sobral 的 4 吋望遠鏡讓我相信星光彎得更多。"
msgstr "索布拉爾的 4 吋望遠鏡讓我相信星光彎得更多。"

msgid "基特"
msgstr "Kit"

msgid "見諸報端"
msgstr "見諸報端"

msgid "歷史紀錄・新聞剪報與插圖"
msgstr "歷史紀錄・新聞剪報與插圖"

msgid "The Times・倫敦・1919 年 11 月 7 日・第 12 頁"
msgstr "The Times・倫敦・1919 年 11 月 7 日・第 12 頁"

msgid "REVOLUTION IN SCIENCE.（科學革命。）"
msgstr "REVOLUTION IN SCIENCE.（科學革命。）"

msgid "NEW THEORY OF THE UNIVERSE.（新的宇宙理論。）"
msgstr "NEW THEORY OF THE UNIVERSE.（新的宇宙理論。）"

msgid "NEWTONIAN IDEAS OVERTHROWN.（牛頓的觀念遭推翻。）"
msgstr "NEWTONIAN IDEAS OVERTHROWN.（牛頓的觀念遭推翻。）"

msgid "The New York Times・紐約・1919 年 11 月 10 日・第 17 頁"
msgstr "The New York Times・紐約・1919 年 11 月 10 日・第 17 頁"

msgid "LIGHTS ALL ASKEW IN THE HEAVENS（天上光線全都歪了）"
msgstr "LIGHTS ALL ASKEW IN THE HEAVENS（天上光線全都歪了）"

msgid "EINSTEIN THEORY TRIUMPHS（愛因斯坦理論獲勝）"
msgstr "EINSTEIN THEORY TRIUMPHS（愛因斯坦理論獲勝）"

msgid "兩組日食觀測支持愛因斯坦預測的較大光線偏折。第三組對底片尺度很敏感。太陽的譜線仍須另行檢驗。"
msgstr "兩組日食觀測支持愛因斯坦預測的較大光線偏折。第三組對底片尺度很敏感。太陽的譜線仍須另行檢驗。"

msgid "英國・1919 年 11 月 11 日。停戰一週年，舉行兩分鐘默哀。"
msgstr "英國・1919 年 11 月 11 日。停戰一週年，舉行兩分鐘默哀。"

msgid "閱讀各方回應"
msgstr "閱讀各方回應"

msgid "虛構評論專欄"
msgstr "虛構評論專欄"

msgid "埃德蒙・魯克"
msgstr "埃德蒙・魯克"

msgid "有關太陽的問題還沒有答案。可他們要我們憑一群不肯站在我們這邊的人說的話，站到柏林那邊去。"
msgstr "有關太陽的問題還沒有答案。可他們要我們憑一群不肯站在我們這邊的人說的話，站到柏林那邊去。"

msgid "The New York Times・紐約・1919 年 11 月 9 日。〈Eclipse Showed Gravity Variation〉（日食顯示重力變化）。"
msgstr "The New York Times・紐約・1919 年 11 月 9 日。〈Eclipse Showed Gravity Variation〉（日食顯示重力變化）。"

msgid "O Paiz・里約熱內盧／Correio Paulistano・聖保羅・1919 年 11 月 9 日。哈瓦斯通訊社的電稿把結果說成一條「反射」定律。"
msgstr "O Paiz・里約熱內盧／Correio Paulistano・聖保羅・1919 年 11 月 9 日。哈瓦斯通訊社的電稿把結果說成一條「反射」定律。"

msgid "The New York Times・紐約・1919 年 11 月 11 日。一篇社論開玩笑說，或許連乘法表都值得懷疑。"
msgstr "The New York Times・紐約・1919 年 11 月 11 日。一篇社論開玩笑說，或許連乘法表都值得懷疑。"

msgid "O Jornal・里約熱內盧・1919 年 11 月 12 日。數學家馬諾埃爾・阿莫羅索・科斯塔的〈Theoria de Einstein〉（愛因斯坦的理論）。"
msgstr "O Jornal・里約熱內盧・1919 年 11 月 12 日。數學家馬諾埃爾・阿莫羅索・科斯塔的〈Theoria de Einstein〉（愛因斯坦的理論）。"

msgid "O Século・里斯本・1919 年 11 月 15 日。〈A Luz Pesa〉（光有重量）。報導由巴黎轉來。"
