msgid "［按 %s 開始］拿底片匣（手上 %d，箱裡還有 %d）"
msgstr "［%s를 눌러 시작］건판 홀더를 가져간다(손에 %d, 상자에 %d 남음)"

msgid "［按 %s 開始］替 Cottingham 報秒、校走速"
msgstr "［%s를 눌러 시작］코팅엄에게 초를 불러 주고 구동 속도를 조정한다"

msgid "［按住 "
