msgstr "［%s］애슈비 선생님이 준 돋보기."

msgid "［%s］再讀工作簿最後一頁。"
msgstr "［%s］작업 공책 마지막 페이지를 다시 읽는다."

msgid "［%s］和 %s 說話"
msgstr "［%s］%s와 말한다"

msgid "［%s］和 Eddington 說話"
msgstr "［%s］에딩턴 교수님과 말한다"

msgid "［%s］在工作簿記下你看到的天空。"
msgstr "［%s］작업 공책에 당신이 본 하늘을 적는다."

msgid "［%s］把 %d 個底片匣放上架子"
msgid_plural "［%s］把 %d 個底片匣放上架子"
msgstr[0] "［%s］건판 홀더 %d개를 선반에 올린다"

msgid "［%s］拿起 Ashby 先生給的放大鏡。"
msgstr "［%s］애슈비 선생님이 준 돋보기를 집어 든다."

msgid "［%s］檢視底片"
msgstr "［%s］건판을 살펴본다"

msgid "［%s］看天文鐘"
msgstr "［%s］천문시계를 본다"

msgid "［%s］看牛津比對底片"
msgstr "［%s］옥스퍼드 비교용 건판을 본다"

