msgid "［按住 %s］上發條"
msgstr "［%s를 누르고 있기］태엽을 감는다"

msgid "［按住 %s］拿底片匣（手上 %d，箱裡還有 %d）"
msgstr "［%s를 누르고 있기］건판 홀더를 가져간다(손에 %d, 상자에 %d 남음)"

msgid "［按住 %s］替 Cottingham 報秒、校走速"
msgstr "［%s를 누르고 있기］코팅엄에게 초를 불러 주고 구동 속도를 조정한다"

msgid "［方向鍵／A 鍵］選擇"
msgstr "［방향키／A 버튼］선택"

msgid "［空白鍵／E／左鍵］開始・停"
msgstr "［스페이스바／E／왼쪽 클릭］시작·정지"

