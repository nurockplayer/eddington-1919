msgstr "[b]제3자 자료와 라이선스[/b]\n%s\n\n%s"

msgid "[b]製作[/b]\n%s\n以 Godot Engine 製作"
msgstr "[b]제작[/b]\n%s\nGodot Engine으로 제작"

msgid "[center]1917 年，劍橋的雨夜。記錄同一片星空的兩張圖，對不上。\n"
msgstr ""

msgid "[center]1917 年，劍橋的雨夜。記錄同一片星空的兩張圖，對不上。\n有人會說，對不上的東西就是假的。\n兩年後，在赤道的雲層底下，你只有 302 秒——去量星光經過太陽時，有沒有彎。[/center]\n"
msgstr "[center]1917년, 케임브리지의 비 오는 밤. 같은 별밭을 그린 두 장의 그림이 서로 맞지 않는다.\n어떤 사람은 말할 것이다, 맞지 않는 것은 가짜라고.\n2년 뒤, 적도의 구름 아래에서, 당신에게는 302초뿐이다—별빛이 태양 곁을 지날 때 휘는지, 재러.[/center]\n"

msgid "[center][b]製作名單[/b]\n%s · v%s[/center]"
msgstr "[center][b]제작진[/b]\n%s · v%s[/center]"

msgid "[color=#9c9]底片就緒[/color]"
msgstr "[color=#9c9]건판 준비됨[/color]"

msgid "[color=#a99]今天要量的：太陽旁邊的星，有沒有被往外推。[/color]"
msgstr "[color=#a99]오늘 잴 것: 태양 옆의 별들이 바깥으로 밀려났는지.[/color]"

msgid "[color=#a99]可選：讀曝光計畫、看牛津比對底片[/color]"
msgstr "[color=#a99]선택: 노출 계획 읽기, 옥스퍼드 비교용 건판 보기[/color]"

msgid "[color=#aaa]Eddington 換片中…[/color]"
msgstr "[color=#aaa]에딩턴이 건판을 가는 중…[/color]"

msgid "[color=#b8ad98]你又放了一次。[/color]"
msgstr "[color=#b8ad98]당신은 한 번 더 틀었다.[/color]"

msgid "[color=#b8ad98]你抬起唱針。房間裡又只剩下雨聲。[/color]"
msgstr "[color=#b8ad98]당신은 바늘을 들어 올린다. 방에는 다시 빗소리만 남는다.[/color]"

msgid "[color=#b8ad98]你放下唱針。[/color]"
msgstr "[color=#b8ad98]당신은 바늘을 내려놓는다.[/color]"

msgid "[color=#b8ad98]兩年前你在這一行旁邊寫的是：%s。[/color]"
msgstr "[color=#b8ad98]2년 전 당신이 이 줄 옆에 쓴 것은: %s.[/color]"

msgid "[color=#b8ad98]這台小機器的軌道是齒輪定死的，演不出那 43 角秒。[/color]"
msgstr "[color=#b8ad98]이 작은 기계의 궤도는 기어로 고정되어 있어서, 그 43초각을 재현할 수 없다.[/color]"

msgid "[color=#b8ad98]點選卡片放進計畫；再點一次可以拿回來。%s和 Eddington 會說出他們的想法。[/color]"
msgstr "[color=#b8ad98]카드를 눌러 계획에 넣는다. 다시 누르면 되돌릴 수 있다. %s과 에딩턴이 각자의 생각을 말한다.[/color]"

msgid "[color=#db8]準備好了就告訴 Eddington，或等倒數結束[/color]"
msgstr "[color=#db8]준비되면 에딩턴에게 알리거나, 카운트다운이 끝나기를 기다린다[/color]"

msgid "[color=#e88]可辨識的星不足五顆，無法同時解出比例尺與偏折。[/color]"
msgstr "[color=#e88]식별 가능한 별이 다섯 개 미만이라, 축척과 휘어짐을 동시에 풀 수 없다.[/color]"

msgid "[color=#e88]幾乎沒有曝光。[/color]"
msgstr "[color=#e88]거의 노출되지 않았다.[/color]"

msgid "[color=#e88]底片用完了[/color]"
msgstr "[color=#e88]건판을 다 썼다[/color]"

msgid "[color=#e88]第三接觸時快門仍開著——陽光回來，整張過曝。[/color]"
msgstr "[color=#e88]제3접촉 때 셔터가 아직 열려 있었다—햇빛이 돌아와, 건판 전체가 과다 노출되었다.[/color]"

msgid "[color=#fd8]● 曝光中 %.1f 秒[/color]"
msgstr "[color=#fd8]● 노출 중 %.1f초[/color]"

msgid "[color=#fd8]可量，但星像拖長或被雲霧蓋住。[/color]"
msgstr "[color=#fd8]잴 수 있지만, 별의 상이 끌렸거나 구름·안개에 가려졌다.[/color]"

msgid "[color=#fd8]這張還沒讀數——用測微器對好參考星再記下，才會算進結果。[/color]"
msgstr "[color=#fd8]이 건판은 아직 판독값이 없다—측미계로 기준성을 맞추고 기록해야 결과에 들어간다.[/color]"

