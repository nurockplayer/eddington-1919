msgstr "[b]밤 · 암실[/b]\n□ 에딩턴에게 당신의 판단을 보고한다"

msgid "[b]本子上的兩次試驗｜上回 → 這回[/b]\n[font_size=%d]%s[/font_size]"
msgstr "[b]공책에 기록된 두 차례 시험 | 지난번 → 이번[/b]\n[font_size=%d]%s[/font_size]"

