msgstr "［%s］계속"

msgid "［%s］讀曝光計畫"
msgstr "［%s］노출 계획을 읽는다"

msgid "［%s］開始／停"
msgstr "［%s］시작／정지"

msgid "［1–%d 或點擊］選擇"
msgstr "［1–%d 또는 클릭］선택"

