# Korean translations. The zh-TW source text is the msgid.
msgid ""
msgstr ""
"Project-Id-Version: Eddington 1919\n"
"Language: ko\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "\n\n[color=#8f8676]1919 年 11 月 6 日公布的結果：Sobral 1.98″、普林西比 1.61″，都比較接近愛因斯坦的 1.75″。怎麼得出、留下哪些疑問，見「歷史上發生了什麼」。[/color]"
msgstr "\n\n[color=#8f8676]1919년 11월 6일 발표된 결과: 소브랄 1.98″, 프린시페 1.61″—둘 다 아인슈타인의 1.75″에 더 가깝다. 어떻게 얻었고 어떤 의문이 남았는지는 ‘역사에서 무슨 일이 있었나’를 보십시오.[/color]"

msgid "\n\n（"
msgstr ""

msgid "\n1919 年你改成：%s。"
msgstr "\n1919년에 당신이 바꾼 것: %s."

msgid "\nCottingham 只能自己趕著上發條，來不及對時。"
msgstr "\n코팅엄은 혼자 서둘러 태엽을 감느라, 시각을 맞출 겨를이 없었다."

msgid "\n[b]歷史上[/b] [color=#8f8676](HISTORICAL_RECORD，詳見 docs/PROVENANCE.md)[/color]"
msgstr "\n[b]역사 기록[/b] [color=#8f8676](HISTORICAL_RECORD, 자세한 내용은 docs/PROVENANCE.md)[/color]"

msgid "\n[color=#8f8676][font_size=%d]虛構與示意：玩家角色、全部對白、時鐘驅動需要協助的情節、雲的細節、底片影像與所有數值。場景為推測重建；普林西比站沒有已知的現場照片，原始底片也已佚失。[/font_size][/color]"
msgstr "\n[color=#8f8676][font_size=%d]허구와 모의: 플레이어 캐릭터, 모든 대사, 시계 구동 장치에 도움이 필요한 상황, 구름의 세부, 건판 이미지와 모든 수치. 장면은 추측 재구성이며; 프린시페 관측소에는 알려진 현장 사진이 없고, 원본 건판도 소실되었다.[/font_size][/color]"

msgid "\n[color=#fd8]合併：%.2f″ ± %.2f″（兩倍誤差 %.2f–%.2f″）[/color]"
msgstr "\n[color=#fd8]합산: %.2f″ ± %.2f″(오차의 2배 %.2f–%.2f″)[/color]"

msgid "\n你：『停！』　Eddington 換片——真的換片要四秒左右，這段時間按了也沒用。第三接觸之前一定要喊停。"
msgstr "\n당신: ‘정지!’ 에딩턴이 건판을 간다—진짜 교체는 4초쯤 걸려서, 그동안 눌러도 소용없다. 제3접촉 전에는 반드시 정지라고 외쳐야 한다."

msgid "\n全食時：空白鍵（或 RB／X）喊開始與停。"
msgstr "\n개기일식 때: 스페이스바(또는 RB／X)로 시작과 정지를 외친다."

msgid "\n快門還開著——最後那張底片曝到了陽光。"
msgstr "\n셔터가 아직 열려 있다—마지막 건판이 햇빛에 노출되었다."

msgid "\n按「閃爍比對」：同一顆星，在兩張底片上跳一下——那一跳就是要量的東西。\n位移已放大，方便肉眼看見；真正的量測用顯微測微器。"
msgstr "\n‘블링크 비교’를 누르세요: 같은 별이 두 건판 사이에서 위치를 살짝 옮겨 보입니다—그 위치 차이가 바로 측정할 대상입니다.\n변위는 눈으로 보기 쉽게 확대했습니다; 실제 측정은 측미계로 합니다."

msgid "\n發條上滿了，但走速沒有校過。"
msgstr "\n태엽은 가득 감겼지만, 속도는 맞추지 않았다."

msgid "\n第%d號還沒讀數，不會算進去。"
msgstr "\n%d번은 아직 판독값이 없어서 계산에 넣지 않는다."

msgid "\n第一次量：%.2f″ ± %.2f″"
msgstr "\n첫 번째 측정: %.2f″ ± %.2f″"

msgid "\n第一次量：沒有量出任何數值。"
msgstr "\n첫 번째 측정: 어떤 수치도 얻지 못했다."

msgid "\n細線是兩倍誤差：Eddington 的判準是，兩倍誤差之內容得下哪個預測、又排除了哪個。"
msgstr "\n가는 선이 오차의 2배다: 에딩턴의 기준은, 오차의 2배 안에 어느 예측이 들어가고 또 어느 것이 배제되는지다."

msgid "\n（和你的底片放在一起看——兩套儀器、隔一個大西洋。）"
msgstr "\n(당신의 건판과 나란히 본다—두 기기, 대서양 하나를 사이에 두고.)"

msgid " ✓讀"
msgstr " ✓판독"

msgid " 已記"
msgstr " 기록됨"

msgid " 開始］"
msgstr ""

msgid "%.2f″ ± %.2f″（量 %d 張）"
msgid_plural "%.2f″ ± %.2f″（量 %d 張）"
msgstr[0] "%.2f″ ± %.2f″(%d장 측정)"

msgid "%.2f″ ± %.2f″，兩倍誤差是 %.2f″ 到 %.2f″"
msgstr "%.2f″ ± %.2f″, 오차의 2배는 %.2f″에서 %.2f″"

msgid "%s\n\n（史實）"
msgstr "%s\n\n(사실)"

msgid "%s\n\n（虛構）"
msgstr "%s\n\n(허구)"

msgid "%s 協助 Cottingham 上發條"
msgstr "%s 코팅엄이 태엽을 감는 것을 돕는다"

msgid "%s 向 Eddington 報到"
msgstr "%s 에딩턴에게 보고한다"

msgid "%s 和 %s"
msgstr "%s와 %s"

msgid "%s 從暗房（鐵皮屋頂的木屋）搬底片匣到望遠鏡架（已放 %d／%d，手上 %d）"
msgstr "%s 암실(철제 지붕의 목조 건물)에서 건판 홀더를 망원경 선반으로 옮긴다(놓임 %d／%d, 손에 %d)"

msgid "%s 用天文鐘替他校走速"
msgstr "%s 천문시계로 그의 속도를 맞춘다"

msgid "%s、%s 和 %s"
msgstr "%s, %s 그리고 %s"

msgid "%s。%s。"
msgstr "%s. %s."

msgid "%s。還有你。——14 號？讓我看看。"
msgstr "%s. 그리고 당신도.—14번? 어디 봐요."

msgid "%s九點前要 14 號星場的抄錄圖。說是「核對一下就好」。"
msgstr "%s이 아홉 시 전까지 14번 별밭의 모사도를 원하세요. ‘대조만 해보면 된다’고요."

msgid "%s也對過一次吧？我看見紙上有兩種鉛筆的痕跡。寫上去。"
msgstr "%s도 한 번 대조했죠? 종이에 연필 자국이 두 가지로 남아 있어요. 적어 두세요."

msgid "%s大概跟你說過 Dyson 的那篇短文了。"
msgstr "%s이 다이슨의 그 짧은 글에 대해 말씀하셨겠군요."

msgid "%s我要說的只有一句：做他的清單，就像做我的一樣。哪顆星對不上，就寫它對不上。不管那對誰有利。"
msgstr "%s 제가 할 말은 하나예요: 그 사람의 목록도, 제 목록처럼 만드세요. 어느 별이 맞지 않으면, 맞지 않는다고 쓰세요. 그게 누구에게 유리하든."

msgid "%s的帳簿"
msgstr "%s의 장부"

msgid "%s這回，你想改哪一步？先記住自己的打算。"
msgstr "%s 이번에는 어느 단계를 바꾸시겠어요? 먼저 자신의 계획을 기억해 두세요."

msgid "%s（%s）"
msgstr "%s(%s)"

msgid "%s：%s"
msgstr "%s: %s"

msgid "+0.5°　E"
msgstr "+0.5°　E"

msgid "0.87″ 和 1.75″ 都不在範圍裡"
msgstr "0.87″와 1.75″ 모두 범위에 없다"

msgid "0.87。牛頓式的算法給的就是這個。寫下來，比記在心裡好。"
msgstr "0.87. 뉴턴식 계산이 내놓는 값이 바로 이거예요. 머리에 두는 것보다 적어 두는 게 낫죠."

msgid "0.87：照牛頓的算法，只有一半"
msgstr "0.87: 뉴턴식 계산에 따른 절반"

msgid "1.75。愛因斯坦的全部。好——日食那天，我們看看底片怎麼說。"
msgstr "1.75. 아인슈타인의 전부. 좋아요—일식 날, 건판이 뭐라고 하는지 봅시다."

msgid "1.75：愛因斯坦的全部"
msgstr "1.75: 아인슈타인의 전부"

msgid "11 月 6 日，倫敦開會。"
msgstr "11월 6일, 런던에서 회의가 열려요."

msgid "14 號星場　／　玻璃與描圖紙"
msgstr "14번 별밭　／　유리와 투사지"

msgid "17 個點重合了，還有 1 個沒有對上。也看看角落的編號，和鉛筆畫的箭頭。"
msgstr "점 17개가 겹쳤고, 아직 하나가 맞지 않는다. 구석의 번호와 연필로 그린 화살표도 보라."

msgid "1846 年：Le Verrier 只用紙筆，算出一顆沒人見過的行星該在哪裡。Galle 當晚去找——離算出的位置不到一度。"
msgstr "1846년: 르베리에는 종이와 펜만으로 아무도 본 적 없는 행성이 어디에 있어야 하는지 계산해 냈다. 갈레가 그날 밤 찾아 나섰고—계산된 위치에서 1도도 떨어지지 않은 곳에서 발견했다."

msgid "1910 年：哈雷彗星回來了。七十多年前就照牛頓的算法排好日子——Cowell 和 Crommelin 在彗星被望遠鏡再看見之前算的近日點（彗星最靠近太陽的那一刻），只早了不到三天。"
msgstr "1910년: 핼리 혜성이 돌아왔다. 칠십여 년 전에 뉴턴의 계산대로 날짜를 미리 잡아 두었는데—코웰과 크로멜린이 혜성이 다시 망원경에 잡히기 전에 계산한 근일점(혜성이 태양에 가장 가까워지는 순간)은 실제보다 사흘이 채 안 되게 빨랐을 뿐이었다."

msgid "1915 年 11 月，愛因斯坦說他的理論算得出水星那 43 角秒。消息傳到劍橋時，我想：先知道答案再去算，誰都算得對。"
msgstr "1915년 11월, 아인슈타인은 자신의 이론으로 수성의 그 43초각을 계산해 낼 수 있다고 말했다. 소식이 케임브리지에 전해졌을 때, 나는 생각했다: 답을 먼저 알고 계산하면, 누구라도 맞출 수 있다고."

msgid "1915 年觀測日誌"
msgstr "1915년 관측 일지"

msgid "1917 年 11 月 10 日，聯合常設日食委員會決定：如果可能，派隊到巴西的 Sobral 和非洲西岸外海的普林西比島。"
msgstr "1917년 11월 10일, 연합상설일식위원회는 가능하다면 브라질의 소브랄과 아프리카 서해안 앞바다의 프린시페 섬으로 원정대를 보내기로 결정했다."

msgid "1917 年的帳本"
msgstr "1917년의 장부"

msgid "1917 年的筆記"
msgstr "1917년의 노트"

msgid "1918 年 11 月，停戰。"
msgstr "1918년 11월, 휴전."

msgid "1919 年 1 月，用[b]同一具望遠鏡[/b]在牛津夜空拍下的同一片星場（金牛座畢宿星團一帶）。日食這天，太陽正好在這片星前面。"
msgstr "1919년 1월, [b]같은 망원경[/b]으로 옥스퍼드 밤하늘에서 찍은 같은 별밭(황소자리 히아데스 성단 일대). 일식 날, 태양이 바로 이 별들 앞에 온다."

msgid "1919 年 11 月 6 日，皇家學會與皇家天文學會聯席會議公布結果。報告最倚重的是巴西 Sobral 的 4 吋望遠鏡（1.98″ ± 0.12″）；普林西比是 1.61″ ± 0.30″（當年寫的是「機率誤差」，約是一倍標準誤差的三分之二）。Sobral 天體照相儀的結果因焦距改變、星像模糊而未採用——這是有紀錄的技術理由，而非掩蓋。一次遠征並沒有讓所有疑問就此消失。"
msgstr "1919년 11월 6일, 왕립학회와 왕립천문학회 연석회의에서 결과가 발표되었다. 보고서가 가장 중점을 둔 것은 브라질 소브랄의 4인치 망원경(1.98″ ± 0.12″)이었다; 프린시페는 1.61″ ± 0.30″였다(당시에는 ‘확률 오차’라고 썼으며, 대략 1배 표준오차의 3분의 2에 해당한다). 소브랄 천체사진기의 결과는 초점거리 변화와 상의 흐림 때문에 채택되지 않았다—이것은 기록된 기술적 이유이지, 은폐가 아니다. 한 번의 원정으로 모든 의문이 사라진 것은 아니다."

msgid "1919 年 3 月 8 日，兩支日食隊從利物浦搭船出發。"
msgstr "1919년 3월 8일, 두 일식 원정대가 리버풀에서 배를 타고 떠났다."

msgid "1919 年 5 月 29 日"
msgstr "1919년 5월 29일"

msgid "1919 年 5 月 29 日・普林西比"
msgstr "1919년 5월 29일 · 프린시페"

msgid "1919 年 5 月 29 日有一次日全食。那天，太陽會停在金牛座一片星場的前面——那裡的亮星，多得不尋常。"
msgstr "1919년 5월 29일에 개기일식이 있습니다. 그날 태양은 황소자리 별밭 하나 앞에 멈춰 서는데—그곳에는 밝은 별이 유난히 많아요."

msgid "1979 年，有人重新量了 Sobral 的底片（Harvey）：4 吋 1.90″ ± 0.11″，天體照相儀 1.55″ ± 0.34″——支持了當年團隊對那組 0.93″ 的疑慮。"
msgstr "1979년, 누군가 소브랄의 건판을 다시 쟀다(하비): 4인치 1.90″ ± 0.11″, 천체사진기 1.55″ ± 0.34″—당시 팀이 그 0.93″ 수치에 품었던 의문을 뒷받침했다."

msgid "43 角秒很小：一度是 3600 角秒，它還不到一度的八十分之一。可是一百多年的紀錄量下來，這個差比量測誤差大得多，而且每個世紀都往同一邊多走，不會抵消。"
msgstr "43초각은 아주 작다. 1도는 3600초각이니, 1도의 80분의 1도 안 된다. 하지만 백 년이 넘는 기록을 모으면 이 차이는 측정 오차보다 훨씬 크고, 세기가 바뀌어도 늘 같은 쪽으로 더 움직여서 상쇄되지 않는다."

msgid "A 鍵"
msgstr "A 버튼"

msgid "Ashby 先生"
msgstr "애슈비 선생님"

msgid "Ashby 先生在走廊等你。"
msgstr "애슈비 선생님이 복도에서 기다리고 있다."

msgid "Ashby 先生寫的：0.87。\n你寫的：%s（%s）。"
msgstr "애슈비 선생님이 쓴 것: 0.87.\n당신이 쓴 것: %s(%s)."

msgid "Ashby 先生給的放大鏡。"
msgstr "애슈비 선생님이 준 돋보기."

msgid "Cottingham 在定天鏡那裡。早上的濕氣讓時鐘驅動不太聽話，他需要一雙手。"
msgstr "코팅엄은 코엘로스타트 쪽에 있어요. 아침 습기 때문에 시계 구동 장치가 말을 잘 안 들어요. 그를 도와줄 사람이 필요해요."

msgid "Cottingham 看過的那幾張，都在雲後面；其餘的，我說不上來。」"
msgstr "코팅엄이 확인한 몇 장은 구름 뒤에 있었다; 나머지는 나도 잘 모르겠다.’"

msgid "Cottingham：「一半在雲裡，一半透了光。」"
msgstr "코팅엄: ‘절반은 구름 속에, 절반은 빛이 새어 나와요.’"

msgid "Cottingham：「二十秒了——驅動沒對過時，再久星像會拖長。」"
msgstr "코팅엄: ‘20초예요—구동 장치의 시각을 맞추지 않아서, 더 길게 두면 별의 상이 끌립니다.’"

msgid "Cottingham：「二十秒了。」"
msgstr "코팅엄: ‘20초예요.’"

msgid "Cottingham：「太短了，大概什麼都沒留下。」"
msgstr "코팅엄: ‘너무 짧아서, 아마 아무것도 남지 않았을 거예요.’"

msgid "Cottingham：「好，接著去天文鐘那裡。」"
msgstr "코팅엄: ‘좋아요, 그다음엔 천문시계 쪽으로 가시죠.’"

msgid "Cottingham：「整段幾乎都在雲後面。」"
msgstr "코팅엄: ‘거의 내내 구름 뒤에 있었어요.’"

msgid "Cottingham：「這幾秒雲很薄，我看得見日冕的邊。」"
msgstr "코팅엄: ‘이 몇 초는 구름이 얇아서, 코로나 가장자리가 보여요.’"

msgid "Dyson 先生正有這個打算。一處下雨，另一處也許是晴天。"
msgstr "다이슨 경이 바로 그럴 생각이에요. 한쪽에 비가 오면, 다른 쪽은 맑을지도 모르니까요."

msgid "Dyson 的信（推測重建，非原文）"
msgstr "다이슨의 편지(추측 재구성, 원문 아님)"

msgid "Dyson、Eddington、Cottingham 與 1919 年的日食遠征為史實；你、Kit、Ashby 先生、劍橋的那一夜與所有對白為虛構，場景為推測重建。"
msgstr "다이슨, 에딩턴, 코팅엄과 1919년의 개기일식 원정은 역사적 사실입니다; 당신, Kit, 애슈비 선생님, 케임브리지의 그 밤과 모든 대사는 허구이며, 장면은 추측 재구성입니다."

msgid "Eddington 前幾天問我，這棟樓裡誰的紀錄最乾淨。"
msgstr "에딩턴이 며칠 전에 나에게 물었어요, 이 건물에서 누구의 기록이 가장 깨끗한지."

msgid "Eddington 抬頭看了一眼：「雲還是很厚……繼續。」"
msgstr "에딩턴이 고개를 들어 한번 보았다: ‘구름이 아직 두꺼워요…… 계속하세요.’"

msgid "Eddington 用手蓋住了這一格。"
msgstr "에딩턴이 손으로 이 칸을 가렸다."

msgid "Eddington 的清單。（把茶杯推過來，已經涼了）恭喜。真的。"
msgstr "에딩턴의 목록. (식은 찻잔을 밀어 준다) 축하해요. 정말로."

msgid "Eddington 還在換片……"
msgstr "에딩턴이 아직 건판을 갈고 있다……"

msgid "Eddington 那個箱子，我後來又想了一次。這回在一面牆上開個小洞，讓一道光照進去。"
msgstr "에딩턴의 그 상자, 그 뒤로 다시 생각해 봤어요. 이번에는 벽 하나에 작은 구멍을 내고, 빛 한 줄기를 들여보냈죠."

msgid "Eddington："
msgstr "에딩턴:"

msgid "Eddington：「最後一張了。」"
msgstr "에딩턴: ‘마지막 한 장이에요.’"

msgid "Eddington：「看太陽周圍那一小片，不是整片天。那裡變薄了就喊。」"
msgstr "에딩턴: ‘하늘 전체가 아니라 태양 주변의 작은 부분만 보세요. 그쪽 구름이 얇아지면 외치세요.’"

msgid "Eddington：「還有 %d 張底片。」"
msgid_plural "Eddington：「還有 %d 張底片。」"
msgstr[0] "에딩턴: ‘건판이 %d장 남았습니다.’"

msgid "Eddington：沒有底片，只練眼睛和口令。看太陽那一塊雲——變薄就按［%s］喊『開始』，變厚之前喊『停』。"
msgstr "에딩턴: 건판 없이 눈과 구령만 연습해요. 태양 쪽 구름을 보세요—얇아지면 ［%s］를 눌러 ‘시작’이라고 외치고, 두꺼워지기 전에 ‘정지’라고 외치세요."

msgid "Greenwich 來信了。Dyson 寫的，在桌上。你先看。"
msgstr "그리니치에서 편지가 왔어요. 다이슨이 쓴 거예요, 책상 위에 있어요. 먼저 보세요."

msgid "Hall 試過：指數不是 2，是 2.00000016。水星對了——可是別的行星也得跟著對，這才是難處。"
msgstr "홀은 시도했어요: 지수가 2가 아니라 2.00000016이라고. 수성은 맞아떨어졌죠—하지만 다른 행성들도 함께 맞아야 하는데, 그게 어려운 점이에요."

msgid "KIT 的變星底片"
msgstr "KIT의 변광성 건판"

msgid "Kit 念出："
msgstr ""

msgid "Kit 念出：%s"
msgstr "Kit이 읽는다: %s"

msgid "Kit 念出：……"
msgstr "Kit이 읽는다: ……"

msgid "LB／RB"
msgstr "LB／RB"

msgid "Le Verrier 也這麼想。日食的時候大家都在找它——1878 年有人說看見了，沒人能再看見一次。"
msgstr "르베리에도 그렇게 생각했어요. 일식 때마다 다들 그것을 찾았죠—1878년에 누군가 봤다고 했지만, 아무도 다시 보지 못했어요."

msgid "Q　−0.5°"
msgstr "Q　−0.5°"

msgid "Q／E"
msgstr "Q／E"

msgid "RB／X 鍵"
msgstr "RB／X 버튼"

msgid "Seeliger 想過：太陽附近也許有一層看不見的物質，像黃道光的塵。聽起來很合理——可是沒有人能證明它多到足以拉住水星。"
msgstr "젤리거는 생각했어요: 태양 근처에 황도광의 먼지 같은, 보이지 않는 물질층이 있을지도 모른다고. 그럴듯하게 들리죠—하지만 수성을 붙잡을 만큼 그 물질이 많다는 것을 아무도 증명하지 못했어요."

msgid "Sobral 4 吋"
msgstr "소브랄 4인치"

msgid "Sobral 4 吋那一點：細線（兩倍誤差）裡容得下哪一個？"
msgstr "소브랄 4인치의 그 점: 가는 선(오차의 2배) 안에 어느 쪽이 들어가는가?"

msgid "Sobral 4 吋：1.98″，±0.12″ 機率誤差，約 0.18″ 標準差"
msgstr "소브랄 4인치: 1.98″, ±0.12″ 확률 오차, 표준편차 약 0.18″"

msgid "Sobral 天體照相儀"
msgstr "소브랄 천체사진기"

msgid "Sobral 天體照相儀：約 0.93″，沒有可靠的誤差"
msgstr "소브랄 천체사진기: 약 0.93″, 신뢰할 만한 오차 없음"

msgid "Sobral 的 4 吋鏡頭"
msgstr "소브랄의 4인치 렌즈"

msgid "Sobral 的底片在 Greenwich 量完了。\n4 吋鏡頭：1.98″ ± 0.12″。\n天體照相儀：約 0.93″；星像模糊，當天的焦距和比例尺可能變了。"
msgstr "소브랄의 건판은 그리니치에서 다 측정했다.\n4인치 렌즈: 1.98″ ± 0.12″.\n천체사진기: 약 0.93″; 별의 상이 흐려서, 그날의 초점거리와 축척이 바뀌었을 수 있다."

msgid "WASD／左搖桿 移動 · 滑鼠／方向鍵／右搖桿 觀看 · Shift／L3 跑\n%s 互動 · %s 紀錄 · %s 開始與停 · %s 暫停"
msgstr "WASD／왼쪽 스틱 이동 · 마우스／방향키／오른쪽 스틱 시점 · Shift／L3 달리기\n%s 상호작용 · %s 기록 · %s 시작과 정지 · %s 일시정지"

