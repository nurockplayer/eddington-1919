msgid "\n\n[color=#8f8676]1919 年 11 月 6 日公布的結果：Sobral 1.98″、普林西比 1.61″，都比較接近愛因斯坦的 1.75″。怎麼得出、留下哪些疑問，見「歷史上發生了什麼」。[/color]"
msgstr "\n\n[color=#8f8676]1919年11月6日に発表された結果：ソブラル1.98″、プリンシペ1.61″——どちらもアインシュタインの1.75″に近い。どう導かれたか、どんな疑問が残ったかは「史実に何が起きたか」を見よ。[/color]"

msgid "\n\n（"
msgstr ""

msgid "\n1919 年你改成：%s。"
msgstr "\n1919年にあなたが変えた：%s。"

msgid "\nCottingham 只能自己趕著上發條，來不及對時。"
msgstr "\nコッティンガムは一人で巻き上げに追われ、歩度を合わせる間がなかった。"

msgid "\n[b]歷史上[/b] [color=#8f8676](HISTORICAL_RECORD，詳見 docs/PROVENANCE.md)[/color]"
msgstr "\n[b]史実[/b] [color=#8f8676](HISTORICAL_RECORD、詳細は docs/PROVENANCE.md)[/color]"

msgid "\n[color=#8f8676][font_size=%d]虛構與示意：玩家角色、全部對白、時鐘驅動需要協助的情節、雲的細節、底片影像與所有數值。場景為推測重建；普林西比站沒有已知的現場照片，原始底片也已佚失。[/font_size][/color]"
msgstr "\n[color=#8f8676][font_size=%d]虚構と示意：プレイヤー、すべての台詞、時計駆動に人手が要るという筋立て、雲の細部、乾板の画像とすべての数値。場面は推測による再構成で、プリンシペの観測地には知られた現場写真もなく、原板もすでに失われている。[/font_size][/color]"

msgid "\n[color=#fd8]合併：%.2f″ ± %.2f″（兩倍誤差 %.2f–%.2f″）[/color]"
msgstr "\n[color=#fd8]合成：%.2f″ ± %.2f″（誤差の2倍 %.2f–%.2f″）[/color]"

msgid "\n你：『停！』　Eddington 換片——真的換片要四秒左右，這段時間按了也沒用。第三接觸之前一定要喊停。"
msgstr "\nあなた：『停！』　エディントンが乾板を替える——本当の交換は四秒ほどかかり、その間押しても意味はない。第三接触の前には必ず止めること。"

msgid "\n全食時：空白鍵（或 RB／X）喊開始與停。"
msgstr "\n皆既中：スペース（または RB／X）で開始と停を叫ぶ。"

msgid "\n快門還開著——最後那張底片曝到了陽光。"
msgstr "\nシャッターはまだ開いていた——最後の乾板が陽の光を浴びた。"

msgid "\n按「閃爍比對」：同一顆星，在兩張底片上跳一下——那一跳就是要量的東西。\n位移已放大，方便肉眼看見；真正的量測用顯微測微器。"
msgstr "\n「ブリンク比較」を押す：同じ星が二枚の乾板で跳ぶ——その跳びが測りたいものだ。\nずれは肉眼で見えるよう拡大してある。実際の測定には測微計を使う。"

msgid "\n發條上滿了，但走速沒有校過。"
msgstr "\n巻き上げは済んだが、歩度は合わせていない。"

msgid "\n第%d號還沒讀數，不會算進去。"
msgstr "\n第%d番はまだ読み取っていないので、計算に入らない。"

msgid "\n第一次量：%.2f″ ± %.2f″"
msgstr "\n最初の測定：%.2f″ ± %.2f″"

msgid "\n第一次量：沒有量出任何數值。"
msgstr "\n最初の測定：数値は何も測れなかった。"

msgid "\n細線是兩倍誤差：Eddington 的判準是，兩倍誤差之內容得下哪個預測、又排除了哪個。"
msgstr "\n細い線は誤差の2倍：エディントンの基準は、誤差の2倍の範囲にどの予測が収まり、どれが排除されるか、だ。"

msgid "\n（和你的底片放在一起看——兩套儀器、隔一個大西洋。）"
msgstr ""

msgid " ✓讀"
msgstr " ✓読"

msgid " 已記"
msgstr ""

msgid " 開始］"
msgstr ""

msgid "%.2f″ ± %.2f″（量 %d 張）"
msgid_plural "%.2f″ ± %.2f″（量 %d 張）"
msgstr[0] "%.2f″ ± %.2f″（%d枚を測定）"

msgid "%.2f″ ± %.2f″，兩倍誤差是 %.2f″ 到 %.2f″"
msgstr "%.2f″ ± %.2f″、誤差の2倍は %.2f″ から %.2f″"

msgid "%s\n\n（史實）"
msgstr ""

msgid "%s\n\n（虛構）"
msgstr ""

msgid "%s 協助 Cottingham 上發條"
msgstr "%s コッティンガムの巻き上げを手伝う"

msgid "%s 向 Eddington 報到"
msgstr "%s エディントンに挨拶する"

msgid "%s 和 %s"
msgstr "%sと%s"

msgid "%s 從暗房（鐵皮屋頂的木屋）搬底片匣到望遠鏡架（已放 %d／%d，手上 %d）"
msgstr "%s 暗室（トタン屋根の小屋）から底片ホルダーを望遠鏡の棚へ運ぶ（設置済み %d／%d、手元 %d）"

msgid "%s 用天文鐘替他校走速"
msgstr "%s 天文時計で彼の歩度を合わせる"

msgid "%s、%s 和 %s"
msgstr "%s、%s、%s"

msgid "%s。%s。"
msgstr "%s。%s。"

msgid "%s。還有你。——14 號？讓我看看。"
msgstr "%s。それにあなたも。——14番？見せてください。"

msgid "%s九點前要 14 號星場的抄錄圖。說是「核對一下就好」。"
msgstr "%sが9時までに14番星野のトレース図を、と。「ちょっと照合するだけ」だそうです。"

msgid "%s也對過一次吧？我看見紙上有兩種鉛筆的痕跡。寫上去。"
msgstr "%sも一度照合したのでしょう？紙に二種類の鉛筆の跡が見えます。書きなさい。"

msgid "%s大概跟你說過 Dyson 的那篇短文了。"
msgstr "%sがダイソン卿のあの短い論文のことを話したでしょう。"

msgid "%s我要說的只有一句：做他的清單，就像做我的一樣。哪顆星對不上，就寫它對不上。不管那對誰有利。"
msgstr "%s 私が言えるのは一つだけです。彼の一覧を作るのは、私のを作るのと同じです。合わない星があれば、合わないと書きなさい。それが誰の得になるとしても。"

msgid "%s的帳簿"
msgstr "%sの帳簿"

msgid "%s這回，你想改哪一步？先記住自己的打算。"
msgstr "%s 今回は、どの手順を変えたい？まず自分の考えを書き留めておいて。"

msgid "%s（%s）"
msgstr "%s（%s）"

msgid "%s：%s"
msgstr "%s：%s"

msgid "+0.5°　E"
msgstr ""

msgid "0.87″ 和 1.75″ 都不在範圍裡"
msgstr "0.87″も1.75″も範囲に入らない"

msgid "0.87。牛頓式的算法給的就是這個。寫下來，比記在心裡好。"
msgstr "0.87。ニュートン式の計算が出すのはこれです。書き留めたほうが、心に留めておくよりよい。"

msgid "0.87：牛頓式的一半"
msgstr "0.87：ニュートン式の半分"

msgid "1.75。愛因斯坦的全部。好——日食那天，我們看看底片怎麼說。"
msgstr "1.75。アインシュタインの全部。よろしい——日食の日、乾板が何と言うか見ましょう。"

msgid "1.75：愛因斯坦的全部"
msgstr "1.75：アインシュタインの全部"

msgid "11 月 6 日，倫敦開會。"
msgstr "11月6日、ロンドンで会議が開かれる。"

msgid "14 號星場　／　玻璃與描圖紙"
msgstr ""

msgid "17 個點重合了，還有 1 個沒有對上。也看看角落的編號，和鉛筆畫的箭頭。"
msgstr ""

msgid "1846 年：Le Verrier 只用紙筆，算出一顆沒人見過的行星該在哪裡。Galle 當晚去找——離算出的位置不到一度。"
msgstr "1846年：ル・ヴェリエは紙と鉛筆だけで、誰も見たことのない惑星がどこにあるべきかを計算した。ガレはその夜に探し——計算の位置から一度も離れていなかった。"

msgid "1910 年：哈雷彗星回來了。七十多年前就照牛頓的算法排好日子——Cowell 和 Crommelin 在彗星被望遠鏡再看見之前算的近日點（彗星最靠近太陽的那一刻），只早了不到三天。"
msgstr "1910年：ハレー彗星が戻ってきた。七十数年前にニュートンの計算法で日取りが決められていた——コーウェルとクロムリンが、彗星が望遠鏡に再び現れる前に計算した近日点（彗星が太陽にいちばん近づく瞬間）は、わずか三日足らず早かっただけだった。"

msgid "1915 年 11 月，愛因斯坦說他的理論算得出水星那 43 角秒。消息傳到劍橋時，我想：先知道答案再去算，誰都算得對。"
msgstr "1915年11月、アインシュタインは自身の理論から水星のあの43秒角が出ると言った。その報せがケンブリッジに届いたとき、私は思った——先に答えを知ってから計算すれば、誰でも当てられる。"

msgid "1915 年觀測日誌"
msgstr "1915年の観測日誌"

msgid "1917 年 11 月 10 日，聯合常設日食委員會決定：如果可能，派隊到巴西的 Sobral 和非洲西岸外海的普林西比島。"
msgstr "1917年11月10日、合同常設日食委員会は決定した。可能なら、ブラジルのソブラルと、アフリカ西岸沖のプリンシペ島へ隊を送る、と。"

msgid "1917 年的帳本"
msgstr "1917年の帳簿"

msgid "1917 年的筆記"
msgstr "1917年のノート"

msgid "1918 年 11 月，停戰。"
msgstr "1918年11月、休戦。"

msgid "1919 年 1 月，用[b]同一具望遠鏡[/b]在牛津夜空拍下的同一片星場（金牛座畢宿星團一帶）。日食這天，太陽正好在這片星前面。"
msgstr "1919年1月、[b]同じ望遠鏡[/b]でオックスフォードの夜空に撮った同じ星野（牡牛座ヒアデス星団のあたり）。日食の日、太陽はちょうどこの星野の前にある。"

msgid "1919 年 11 月 6 日，皇家學會與皇家天文學會聯席會議公布結果。報告最倚重的是巴西 Sobral 的 4 吋望遠鏡（1.98″ ± 0.12″）；普林西比是 1.61″ ± 0.30″（當年寫的是「機率誤差」，約是一倍標準誤差的三分之二）。Sobral 天體照相儀的結果因焦距改變、星像模糊而未採用——這是有紀錄的技術理由，而非掩蓋。一次遠征並沒有讓所有疑問就此消失。"
msgstr "1919年11月6日、王立学会と王立天文学会の合同会議で結果が発表された。報告が最も重んじたのはブラジル・ソブラルの4インチ望遠鏡（1.98″ ± 0.12″）、プリンシペは1.61″ ± 0.30″（当時は「確率誤差」と書かれ、標準誤差のおよそ三分の二にあたる）。ソブラルの天体写真儀の結果は、焦点距離が変わり星像がぼやけたため採用されなかった——これは記録に残る技術的な理由であって、隠蔽ではない。一度の遠征で疑問がすべて消えたわけではない。"

msgid "1919 年 3 月 8 日，兩支日食隊從利物浦搭船出發。"
msgstr "1919年3月8日、二つの日食隊がリバプールから船で出発した。"

msgid "1919 年 5 月 29 日"
msgstr ""

msgid "1919 年 5 月 29 日・普林西比"
msgstr "1919年5月29日・プリンシペ"

msgid "1919 年 5 月 29 日有一次日全食。那天，太陽會停在金牛座一片星場的前面——那裡的亮星，多得不尋常。"
msgstr "1919年5月29日に皆既日食があります。その日、太陽は牡牛座のある星野の前で止まります——そこは明るい星が、不自然なほど多い。"

msgid "1979 年，有人重新量了 Sobral 的底片（Harvey）：4 吋 1.90″ ± 0.11″，天體照相儀 1.55″ ± 0.34″——支持了當年團隊對那組 0.93″ 的疑慮。"
msgstr "1979年、ソブラルの乾板が誰かによって測り直された（Harvey）。4インチは1.90″ ± 0.11″、天体写真儀は1.55″ ± 0.34″——当時のチームがその組の0.93″に抱いていた疑いを裏づけた。"

msgid "43 角秒很小：一度是 3600 角秒，它還不到一度的八十分之一。可是一百多年的紀錄量下來，這個差比量測誤差大得多，而且每個世紀都往同一邊多走，不會抵消。"
msgstr "43秒角はとても小さい。一度は3600秒角で、その八十分の一にも満たない。だが百年余りの記録を積み重ねると、この差は測定誤差よりはるかに大きく、しかも世紀ごとに同じ側へ進み続け、打ち消し合わない。"

msgid "A 鍵"
msgstr ""

msgid "Ashby 先生"
msgstr "アシュビー先生"

msgid "Ashby 先生在走廊等你。"
msgstr ""

msgid "Ashby 先生寫的：0.87。\n你寫的：%s（%s）。"
msgstr "アシュビー先生が書いた：0.87。\nあなたが書いた：%s（%s）。"

msgid "Ashby 先生給的放大鏡。"
msgstr "アシュビー先生にもらった虫めがね。"

msgid "Cottingham 在定天鏡那裡。早上的濕氣讓時鐘驅動不太聽話，他需要一雙手。"
msgstr "コッティンガムはシーロスタットのところにいます。朝の湿気で時計駆動の調子が悪く、人手が要るのです。"

msgid "Cottingham 看過的那幾張，都在雲後面；其餘的，我說不上來。」"
msgstr "コッティンガムが見た数枚は雲の後ろでした。残りは、私にはよくわからない。」"

msgid "Cottingham：「一半在雲裡，一半透了光。」"
msgstr "コッティンガム：「半分は雲の中、半分は光が透けた。」"

msgid "Cottingham：「二十秒了——驅動沒對過時，再久星像會拖長。」"
msgstr "コッティンガム：「二十秒たった——駆動を合わせていないと、これ以上は星像が伸びる。」"

msgid "Cottingham：「二十秒了。」"
msgstr "コッティンガム：「二十秒たった。」"

msgid "Cottingham：「太短了，大概什麼都沒留下。」"
msgstr "コッティンガム：「短すぎる、おそらく何も残っていない。」"

msgid "Cottingham：「好，接著去天文鐘那裡。」"
msgstr "コッティンガム：「よし、次は天文時計のところへ。」"

msgid "Cottingham：「整段幾乎都在雲後面。」"
msgstr "コッティンガム：「ほとんどずっと雲の後ろだ。」"

msgid "Cottingham：「這幾秒雲很薄，我看得見日冕的邊。」"
msgstr "コッティンガム：「この数秒は雲が薄い、日冕の縁が見える。」"

msgid "Dyson 先生正有這個打算。一處下雨，另一處也許是晴天。"
msgstr "ダイソン卿もそう考えています。片方が雨でも、もう片方は晴れているかもしれません。"

msgid "Dyson 的信（推測重建，非原文）"
msgstr "ダイソン卿の手紙（推測による再構成、原文ではない）"

msgid "Dyson、Eddington、Cottingham 與 1919 年的日食遠征為史實；你、Kit、Ashby 先生、劍橋的那一夜與所有對白為虛構，場景為推測重建。"
msgstr ""

msgid "Eddington 前幾天問我，這棟樓裡誰的紀錄最乾淨。"
msgstr "エディントンが先日、この建物で誰の記録がいちばん汚れがないかと聞いてきた。"

msgid "Eddington 抬頭看了一眼：「雲還是很厚……繼續。」"
msgstr "エディントンが顔を上げて一瞥した：「雲はまだ厚い……続けてくれ。」"

msgid "Eddington 用手蓋住了這一格。"
msgstr "エディントンが手でこの図を覆った。"

msgid "Eddington 的清單。（把茶杯推過來，已經涼了）恭喜。真的。"
msgstr "エディントンの一覧。（冷めた茶碗を押しやる）おめでとう。本当に。"

msgid "Eddington 還在換片……"
msgstr "エディントンはまだ乾板を替えている……"

msgid "Eddington 那個箱子，我後來又想了一次。這回在一面牆上開個小洞，讓一道光照進去。"
msgstr "エディントンのあの箱のことを、あとでもう一度考えた。今度は壁の一面に小さな穴を開け、光を一筋入れさせてみた。"

msgid "Eddington："
msgstr "エディントン："

msgid "Eddington：「最後一張了。」"
msgstr "エディントン：「最後の一枚だ。」"

msgid "Eddington：「看太陽周圍那一小片，不是整片天。那裡變薄了就喊。」"
msgstr "エディントン：「見るのは太陽のまわり、あの小さな一角だ。空全体ではない。そこが薄くなったら声をかけてくれ。」"

msgid "Eddington：「還有 %d 張底片。」"
msgid_plural "Eddington：「還有 %d 張底片。」"
msgstr[0] "エディントン：「乾板はまだ%d枚ある。」"

msgid "Eddington：沒有底片，只練眼睛和口令。看太陽那一塊雲——變薄就按［%s］喊『開始』，變厚之前喊『停』。"
msgstr "エディントン：乾板はない、目と掛け声の練習だけだ。太陽のあの雲を見て——薄くなったら［%s］を押して『開始』、厚くなる前に『停』と言う。"

msgid "Greenwich 來信了。Dyson 寫的，在桌上。你先看。"
msgstr "グリニッジから手紙が来た。ダイソン卿のもので、机の上にある。先に見なさい。"

msgid "Hall 試過：指數不是 2，是 2.00000016。水星對了——可是別的行星也得跟著對，這才是難處。"
msgstr "ホールは試した。指数は2ではなく、2.00000016だ。水星は合った——だが他の惑星も合わねばならない。そこが難しい。"

msgid "KIT 的變星底片"
msgstr ""

msgid "Kit 念出："
msgstr ""

msgid "Kit 念出：%s"
msgstr ""

msgid "Kit 念出：……"
msgstr "Kit の読み上げ：……"

msgid "LB／RB"
msgstr ""

msgid "Le Verrier 也這麼想。日食的時候大家都在找它——1878 年有人說看見了，沒人能再看見一次。"
msgstr "ル・ヴェリエもそう考えた。日食のたびに皆がそれを探した——1878年に見たという人がいたが、二度と誰も見られなかった。"

msgid "Q　−0.5°"
msgstr ""

msgid "Q／E"
msgstr ""

msgid "RB／X 鍵"
msgstr ""

msgid "Seeliger 想過：太陽附近也許有一層看不見的物質，像黃道光的塵。聽起來很合理——可是沒有人能證明它多到足以拉住水星。"
msgstr "ゼーリガーは考えた。太陽の近くに、黄道光の塵のような見えない物質の層があるのではないか。もっともらしい——だが、水星を引っぱるほど多くあることを証明した人はいない。"

msgid "Sobral 4 吋"
msgstr ""

msgid "Sobral 4 吋那一點：細線（兩倍誤差）裡容得下哪一個？"
msgstr ""

msgid "Sobral 4 吋：1.98″，±0.12″ 機率誤差，約 0.18″ 標準差"
msgstr ""

msgid "Sobral 天體照相儀"
msgstr ""

