; Engine configuration file.
; Godot 4.7.2.stable

config_version=5

[application]

config/name="雲層之後 · Eddington 1919"
config/version="0.4.5"
config/icon="res://icon.svg"
config/description="A short narrative game: from a Cambridge light box in 1917 to the clouded eclipse of 1919, measure the evidence yourself."
config/use_custom_user_dir=true
config/custom_user_dir_name="Eddington1919"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Story="*res://scripts/story.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
textures/vram_compression/import_etc2_astc=true
